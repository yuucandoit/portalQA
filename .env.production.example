# ==============================================================================
# QA PORTAL - PRODUCTION ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env di server: cp .env.production.example .env
# ==============================================================================

APP_NAME="QA Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://qaportal.yourdomain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# Database Configuration (Default SQLite: tersimpan aman di Docker volume)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# Host Port Mapping
APP_PORT=9012

# WebSocket Real-Time Chat Configuration
CHAT_WS_PORT=6001
CHAT_WS_HOST=0.0.0.0

# Session & Security Settings (Diwajibkan true jika menggunakan HTTPS / Domain)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# PWA / HTTPS Settings
BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database

# AI Providers (Opsional - Diisi jika ingin fitur AI Daily Standup & AI Test Case)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

